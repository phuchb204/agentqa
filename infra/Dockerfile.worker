FROM ghcr.io/astral-sh/uv:0.10.7 AS uv

FROM python:3.13-slim-bookworm AS runtime

COPY --from=uv /uv /uvx /bin/

WORKDIR /app
COPY pyproject.toml uv.lock README.md ./
COPY src ./src
COPY benchmarks/apps/taskboard ./benchmarks/apps/taskboard
RUN uv sync --locked --no-dev --no-editable

ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
RUN /app/.venv/bin/playwright install --with-deps chromium

RUN useradd --create-home --uid 10001 appuser \
    && mkdir -p /var/lib/agentqa/artifacts /var/lib/agentqa/scratch \
    && chown -R appuser:appuser /app /var/lib/agentqa /ms-playwright

COPY infra/entrypoint.sh /usr/local/bin/agentqa-entrypoint
RUN chmod +x /usr/local/bin/agentqa-entrypoint

ENV PATH="/app/.venv/bin:$PATH" \
    AGENTQA_ARTIFACT_DIR=/var/lib/agentqa/artifacts \
    AGENTQA_WORKSPACE_ROOT=/app

ENTRYPOINT ["/usr/local/bin/agentqa-entrypoint"]

CMD ["python", "-m", "agentqa.platform.runs.worker_daemon"]

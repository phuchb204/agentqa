FROM ghcr.io/astral-sh/uv:0.10.7 AS uv

FROM python:3.13-slim-bookworm AS runtime

COPY --from=uv /uv /uvx /bin/

WORKDIR /app
COPY pyproject.toml uv.lock README.md ./
COPY src ./src
COPY infra/migrations ./infra/migrations
RUN uv sync --locked --no-dev --no-editable

RUN useradd --create-home --uid 10001 appuser \
    && mkdir -p /var/lib/agentqa/artifacts \
    && chown -R appuser:appuser /app /var/lib/agentqa

COPY infra/entrypoint.sh /usr/local/bin/agentqa-entrypoint
RUN chmod +x /usr/local/bin/agentqa-entrypoint

ENV PATH="/app/.venv/bin:$PATH" \
    AGENTQA_ARTIFACT_DIR=/var/lib/agentqa/artifacts \
    AGENTQA_API_HOST=0.0.0.0 \
    AGENTQA_API_PORT=8000 \
    AGENTQA_MIGRATIONS_DIR=/app/infra/migrations

ENTRYPOINT ["/usr/local/bin/agentqa-entrypoint"]
EXPOSE 8000

CMD ["python", "-m", "agentqa.platform.api.server"]

AGENTQA_LLM_API_KEY=
AGENTQA_LLM_BASE_URL=https://opencode.ai/zen/v1
AGENTQA_LLM_MODEL=deepseek-v4-flash
AGENTQA_LLM_API=chat
# OpenCode Go (subscription): base_url=https://opencode.ai/zen/go/v1, model=deepseek-v4.1-flash
# Go responses-API models (ví dụ Muse Spark 1.3 Contributor — prompt/completion được dùng để train):
#   base_url=https://opencode.ai/zen/go/v1, model=muse-spark-1.3-contributor, AGENTQA_LLM_API=responses
# Alternatives:
# DeepSeek direct: base_url=https://api.deepseek.com, model=deepseek-v4-flash
# OpenRouter:      base_url=https://openrouter.ai/api/v1
# Gemini compat:   base_url=https://generativelanguage.googleapis.com/v1beta/openai/
# Ollama local:    base_url=http://localhost:11434/v1, model tuỳ máy, key bỏ trống
# Jev (decision model qua OpenRouter — tuỳ chọn, cho cascade/decision layer ở giai đoạn sau):
#   key OpenRouter: https://openrouter.ai/settings/keys (fallback sang OPENROUTER_API_KEY nếu bỏ trống)
AGENTQA_JEV_API_KEY=
# AGENTQA_JEV_BASE_URL=https://openrouter.ai/api/alpha/decisions
# AGENTQA_JEV_MODEL=typesafe/jev-1.13   # hoặc ~typesafe/jev-latest (track bản mới nhất)

# Policy agent: llm (mặc định, free-form JSON) hoặc jev (cascade Jev chọn action + LLM sinh text)
AGENTQA_POLICY=llm
# Ngưỡng cascade (chỉ dùng khi AGENTQA_POLICY=jev)
# AGENTQA_JEV_GOAL_DONE_MIN=0.8
# AGENTQA_JEV_STUCK_MIN=0.8
# AGENTQA_JEV_CONF_MIN=0.6
# AGENTQA_JEV_MAX_OPTIONS=255
